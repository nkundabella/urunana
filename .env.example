# PostgreSQL
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=your_database_name
POSTGRES_PORT=5432
DATABASE_URL=postgresql://your_database_user:your_database_password@localhost:5432/your_database_name?schema=public

# Backend API (Fastify)
BACKEND_PORT=4000
JWT_SECRET=change_me_to_a_random_32_char_minimum_secret
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads

# Frontend -> Backend proxy target (use http://backend:4000 inside Docker)
INTERNAL_API_URL=http://localhost:4000
