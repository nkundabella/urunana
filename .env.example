# ==============================================================================
# Urunana Platform — Environment Configuration Template
# Copy to `.env` at the monorepo root before running locally or via Docker.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database (Required)
# ------------------------------------------------------------------------------
POSTGRES_USER=urunana
POSTGRES_PASSWORD=change_me_to_a_strong_database_password
POSTGRES_DB=urunana_dev
POSTGRES_PORT=5432

# Host port mapped to the Docker `db` container (defaults to 5433 so it won't
# conflict if you already run a local PostgreSQL service on 5432).
DOCKER_POSTGRES_PORT=5433

# Local host connection string (used when running `npm run dev` outside Docker).
# Inside `docker-compose.yml`, the `backend` container automatically overrides
# DATABASE_URL to connect via the internal Docker service host `@db:5432`.
DATABASE_URL=postgresql://urunana:change_me_to_a_strong_database_password@localhost:5432/urunana_dev?schema=public

# ------------------------------------------------------------------------------
# Backend API (Fastify + Prisma)
# ------------------------------------------------------------------------------
BACKEND_PORT=4000

# Required: minimum 32 characters (server exits on startup if shorter or missing).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_secret_at_least_32_characters_long

# Allowed browser origins (comma-separated for multiple domains)
CORS_ORIGIN=http://localhost:3000

# Public URL used in password-reset links logged by the mailer
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local upload directory (overridden to `/app/uploads` inside Docker)
UPLOAD_DIR=./uploads

# Optional: run idempotent `prisma db seed` automatically on Docker container boot
SEED_ON_BOOT=true

# Optional: explicitly force Secure cookie attribute (`true` on HTTPS production,
# `false` for local HTTP Docker testing on http://localhost:3000)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Frontend (Next.js 16)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000

# Backend origin for Next.js SSR & `/api/v1/*` + `/uploads/*` proxy rewrites.
# Use `http://localhost:4000` locally; Docker Compose sets `http://backend:4000`.
INTERNAL_API_URL=http://localhost:4000
